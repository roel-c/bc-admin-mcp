# Required — store-specific BigCommerce API credentials.
# Create a dedicated API account with only the scopes needed for the tools you
# will use. Never paste credentials into tool arguments or Cursor chat.
BC_STORE_HASH=your_store_hash
BC_AUTH_TOKEN=your_api_token
# Keep real values only in your local .env (never commit secrets).

# Optional — BigCommerce client tuning (defaults match docs/DEVELOPMENT.md conservative mode)
# BC_REQUESTS_PER_SECOND=2.0
# BC_QUOTA_SAFETY_BUFFER=25
# BC_MAX_RETRIES=6
# BC_PRODUCT_BATCH_SIZE=10
# BC_VARIANT_BATCH_SIZE=10
# BC_INVENTORY_BATCH_SIZE=10
# BC_DEFAULT_PAGE_LIMIT=250
# BC_MAX_TOTAL_RECORDS=10000
# BC_DELAY_BETWEEN_CHUNKS_MS=500
# BC_MAX_WRITE_CONCURRENCY=1
# BC_CACHE_TTL_SECONDS=60

# Optional — B2B Edition is disabled by default. Set to true only if the store
# uses B2B Edition and this API account has the required B2B scope. When true,
# the b2b/ tool root reuses BC_AUTH_TOKEN + BC_STORE_HASH; no separate
# credentials are needed. See docs/B2B.md.
BC_B2B_ENABLED=false

# Optional — allow B2B company attachment uploads from one dedicated directory.
# Leave unset to disable uploads. Use an absolute local path, keep sensitive
# files outside it, and pass only relative file_path values to the tool.
# BC_UPLOAD_DIR=/absolute/path/to/bc-admin-uploads

# Supported setup — local Cursor stdio via scripts/launch-mcp.sh.
# MCP_SERVER_NAME=bigcommerce-mcp
# MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=stdio
